# ----------------------------------------------------------------------
# Identity
# ----------------------------------------------------------------------
MCU STM32G4xx STM32G474xx
FLASH_SIZE_KB 256

# Temporary board ID (a real one must be reserved before upstreaming)
APJ_BOARD_ID 9999

env AP_PERIPH 1

# No crystal: internal oscillator
OSCILLATOR_HZ 0

# ----------------------------------------------------------------------
# Flash
# Page 62 = 124 KB offset (last page of flash bank 1).
# Firmware is limited to 124 KB because of this.
# ----------------------------------------------------------------------
FLASH_RESERVE_START_KB 0
define AP_BOOTLOADER_FLASHING_ENABLED 0

STORAGE_FLASH_PAGE 62
define HAL_STORAGE_SIZE 1800

# Keep NRST as a reset input (reset button)
define HAL_FLASH_SET_NRST_MODE 0x01

# ----------------------------------------------------------------------
# UARTs
# ----------------------------------------------------------------------
SERIAL_ORDER USART1 USART2

# USART1: Mosaic-g5 (SBF, 115200)
PA10 USART1_RX USART1
PA9  USART1_TX USART1
DMA_NOSHARE USART1*

# USART2: user UART on solder pads
PA3 USART2_RX USART2
PA2 USART2_TX USART2

# ----------------------------------------------------------------------
# SWD
# ----------------------------------------------------------------------
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# ----------------------------------------------------------------------
# FDCAN1 -> CAN transceiver
# ----------------------------------------------------------------------
PA11 CAN1_RX CAN1
PA12 CAN1_TX CAN1

# CAN status LED
# Fast blink = waiting for node ID, slow blink = DroneCAN running
PB9 LED OUTPUT HIGH
define HAL_LED_ON 1

# ----------------------------------------------------------------------
# I2C
# Bus 0 = I2C3 : external JST 4-pin connector (J7), 10k pull-ups
# Bus 1 = I2C4 : internal magnetometer bus + solder pads
# ----------------------------------------------------------------------
PA8 I2C3_SCL I2C3
PC9 I2C3_SDA I2C3

PC6 I2C4_SCL I2C4
PC7 I2C4_SDA I2C4

I2C_ORDER I2C3 I2C4

# ----------------------------------------------------------------------
# Magnetometer: LIS2MDL on bus 1 (register-compatible with IIS2MDC), 0x1E
# ----------------------------------------------------------------------
COMPASS IIS2MDC I2C:1:0x1E false ROTATION_NONE

# ----------------------------------------------------------------------
# Minimal HAL
# ----------------------------------------------------------------------
define HAL_USE_SERIAL TRUE
define HAL_USE_EMPTY_IO TRUE

define STM32_SERIAL_USE_USART1 TRUE
define STM32_SERIAL_USE_USART2 TRUE
define STM32_SERIAL_USE_USART3 FALSE

define HAL_USE_ADC FALSE
define DMA_RESERVE_SIZE 0

define HAL_DEVICE_THREAD_STACK 768
define AP_PARAM_MAX_EMBEDDED_PARAM 256

# ----------------------------------------------------------------------
# AP_Periph features: GNSS + magnetometer
# ----------------------------------------------------------------------
define AP_PERIPH_GPS_ENABLED 1
define HAL_PERIPH_GPS_PORT_DEFAULT 0
define GPS_MAX_RECEIVERS 1
define GPS_MAX_INSTANCES 1

define AP_PERIPH_MAG_ENABLED 1
define HAL_COMPASS_MAX_SENSORS 1

define AP_PERIPH_IMU_ENABLED 0
define AP_PERIPH_BARO_ENABLED 0
define AP_PERIPH_NOTIFY_ENABLED 0

# ----------------------------------------------------------------------
# Flash saving: only build the drivers this board uses
# ----------------------------------------------------------------------
# GNSS: Septentrio SBF only
define AP_GPS_BACKEND_DEFAULT_ENABLED 0
define AP_GPS_SBF_ENABLED 1

# Compass: IIS2MDC / LIS2MDL only
define AP_COMPASS_BACKEND_DEFAULT_ENABLED 0
define AP_COMPASS_IIS2MDC_ENABLED 1
